<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout con footer fisso:
  - ScrollView con tutto il contenuto della pagina
  - Footer con i 3 bottoni fissato in basso
  - Barra di microfeedback (status) fissata sotto al footer
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Contenuto scrollabile -->
    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/footerContainer"
        android:background="#000000">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000">

            <EditText
                android:id="@+id/baseUrlEdit"
                android:hint="Jira Base URL (https://tenant.atlassian.net)"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/emailEdit"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Riga orizzontale: campo API Token + pulsante info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/tokenEdit"
                    android:hint="API Token"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9AA0A6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/infoTokenBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:contentDescription="@string/token_info_desc"
                    android:src="@drawable/info_icon"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:tint="@null"/>
            </LinearLayout>

            <EditText
                android:id="@+id/jqlEdit"
                android:hint='JQL (opcional, para filtrar os cards)'
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- BLOCCO ORA: testo a sinistra, timepicker a destra (subito sotto JQL) -->
            <LinearLayout
                android:id="@+id/timeBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/timeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/time_block_label"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:lineSpacingExtra="2dp"/>

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"
                    android:layout_marginStart="16dp"
                    android:theme="@style/PointDown.TimePickerText"/>
            </LinearLayout>

            <!-- Sezione AVANZATE (toggle, nascosta di default) -->
            <LinearLayout
                android:id="@+id/advancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:visibility="gone">

                <!-- ✅ NUOVO: Filtri di Status (match estensione) -->
                <TextView
                    android:id="@+id/statusFiltersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_status_filters_title"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/statusFiltersRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/st_todo"
                        android:text="@string/st_todo"
                        android:textColor="#FFFFFF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/st_inprogress"
                        android:text="@string/st_inprogress"
                        android:textColor="#FFFFFF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statusFiltersRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/st_blocked"
                        android:text="@string/st_blocked"
                        android:textColor="#FFFFFF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/st_needreqs"
                        android:text="@string/st_needreqs"
                        android:textColor="#FFFFFF"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/st_done"
                    android:text="@string/st_done"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/statusFiltersHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_status_filters_hint"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"/>

                <CheckBox
                    android:id="@+id/forceTestCardCheck"
                    android:text="@string/settings_force_test_card_title"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingTop="8dp"/>

                <EditText
                    android:id="@+id/testIssueKeyEdit"
                    android:hint="@string/settings_test_issue_key_hint"
                    android:inputType="text"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9AA0A6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="true"/>

                <CheckBox
                    android:id="@+id/enableQueueLockCheck"
                    android:text="@string/settings_enable_queue_lock_title"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingTop="8dp"/>

                <CheckBox
                    android:id="@+id/enableWeekendCheck"
                    android:text="@string/settings_enable_weekend_title"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingTop="8dp"/>
            </LinearLayout>

            <!-- Spazio finale per non tagliare l'ultimo elemento quando si arriva in fondo -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Footer fisso con i tre bottoni: sfondo TRASPARENTE
         (si deve vedere il nero del banner sotto) -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/feedbackBar"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:elevation="8dp">

        <!-- Bottoni con stile Material3 di sistema (riempiti, viola/rosa)
             Nessun background personalizzato qui -->
        <Button
            android:id="@+id/advancedBtn"
            android:text="@string/advanced_btn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="none"
            android:hyphenationFrequency="none"
            android:breakStrategy="balanced"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="18dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeStepGranularity="1sp"/>

        <Button
            android:id="@+id/testBtn"
            android:text="@string/settings_test_conn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.3"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="none"
            android:hyphenationFrequency="none"
            android:breakStrategy="balanced"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="18dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeStepGranularity="1sp"/>

        <Button
            android:id="@+id/saveBtn"
            android:text="@string/settings_save_btn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.9"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="none"
            android:hyphenationFrequency="none"
            android:breakStrategy="balanced"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="18dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeStepGranularity="1sp"/>
    </LinearLayout>

    <!-- Microfeedback fisso, subito sotto al footer -->
    <LinearLayout
        android:id="@+id/feedbackBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#101010"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/statusTextSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

</RelativeLayout>
