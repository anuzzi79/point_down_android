<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footerContainer">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000">

            <EditText
                android:id="@+id/baseUrlEdit"
                android:hint="Jira Base URL (https://tenant.atlassian.net)"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/emailEdit"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- API Token + info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/tokenEdit"
                    android:hint="API Token"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9AA0A6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/infoTokenBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/info_icon"
                    app:tint="@null"/>
            </LinearLayout>

            <EditText
                android:id="@+id/jqlEdit"
                android:hint='JQL (opcional, para filtrar os cards)'
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- ✅ BLOCCO PERFIL: label e due checkbox allineati -->
            <LinearLayout
                android:id="@+id/profileBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/profileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perfil:"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:paddingEnd="12dp"/>

                <CheckBox
                    android:id="@+id/qaCheck"
                    android:text="Sou QA"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"/>

                <CheckBox
                    android:id="@+id/devCheck"
                    android:text="Sou DEV"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ✅ BLOCCO ORA -->
            <LinearLayout
                android:id="@+id/timeBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/timeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/time_block_label"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"/>

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"
                    android:theme="@style/PointDown.TimePickerText"/>
            </LinearLayout>

            <!-- ✅ BLOCCO SQUAD MODE (visibile solo se Sou DEV) -->
            <LinearLayout
                android:id="@+id/squadModeBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/squadModeCheck"
                    android:text="Ativar Squad Mode (DEV)"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Keyword input row: text + add button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp">

                    <EditText
                        android:id="@+id/squadKeywordsEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ex.: buffer, Support Dev"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9AA0A6"/>

                    <ImageButton
                        android:id="@+id/addKeywordBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Add keyword"
                        android:src="@drawable/ic_add"
                        android:tint="#FFFFFF"/>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/keywordsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    app:singleLine="false"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"/>

                <!-- Squad Epics (FGC-<num>) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp">

                    <EditText
                        android:id="@+id/squadEpicInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="FGC-1234 → digite só números (ex.: 1234)"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9AA0A6"/>

                    <ImageButton
                        android:id="@+id/addSquadEpicBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Add epic"
                        android:src="@drawable/ic_add"
                        android:tint="#FFFFFF"/>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/squadEpicChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    app:singleLine="false"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"/>
            </LinearLayout>

            <!-- Sezione avanzata rimane in basso -->
            <LinearLayout
                android:id="@+id/advancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:visibility="gone">

                <!-- Status Filters Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filtros de Status (lista principal)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="4"
                        android:columnOrderPreserved="false">

                        <CheckBox android:id="@+id/st_todo" android:text="To Do" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_inprogress" android:text="In Progress" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_blocked" android:text="Blocked" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_needreqs" android:text="Need Reqs" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_done" android:text="Done" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_codereview" android:text="Code Review" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_testing" android:text="Testing" android:textColor="#FFFFFF"/>
                        <CheckBox android:id="@+id/st_qa" android:text="QA" android:textColor="#FFFFFF"/>
                    </GridLayout>
                </LinearLayout>

                <!-- Search Codes (FGC-<num>) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chama também os cards com código..."
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp">

                        <EditText
                            android:id="@+id/searchCodeInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:hint="FGC-1234 → digite só números (ex.: 1234)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#9AA0A6"/>

                        <ImageButton
                            android:id="@+id/addSearchCodeBtn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Add code"
                            android:src="@drawable/ic_add"
                            android:tint="#FFFFFF"/>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/searchCodesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        app:singleLine="false"
                        app:singleSelection="false"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"/>
                </LinearLayout>

                <!-- Advanced Toggles -->
                <CheckBox
                    android:id="@+id/forceTestCardCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sim, quero que apareça a card de teste! (FGC-9683)"
                    android:textColor="#FFFFFF"
                    android:paddingTop="16dp"/>

                <CheckBox
                    android:id="@+id/enableQueueLockCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativar fila/lock cooperativo (anti-concorrência) via Issue Property"
                    android:textColor="#FFFFFF"
                    android:paddingTop="8dp"/>

                <CheckBox
                    android:id="@+id/enableWeekendCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativar notificações também sábado e domingo (test)"
                    android:textColor="#FFFFFF"
                    android:paddingTop="8dp"/>

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:elevation="8dp">

        <Button
            android:id="@+id/advancedBtn"
            android:text="@string/advanced_btn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/testBtn"
            android:text="@string/settings_test_conn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/saveBtn"
            android:text="@string/settings_save_btn"
            android:textColor="#FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>
